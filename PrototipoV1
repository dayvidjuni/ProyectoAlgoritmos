import whisper
import torch
from transformers import pipeline
import sounddevice as sd
import soundfile as sf

MODEL_NAME = "finiteautomata/beto-emotion-analysis"
AUDIO_FILENAME = "grabacion.wav"
DURATION = 7  # duración de grabación en segundos

# Grabar el audio
def grabar_audio(filename, duration=5, samplerate=16000):
    print("Grabando... Habla ahora")
    audio = sd.rec(int(samplerate * duration), samplerate=samplerate, channels=1)
    sd.wait()
    sf.write(filename, audio, samplerate)
    print("Grabación guardada\n")

# 2. Transcribir audio con Whisper, gracias OPEN
def transcribir_audio(modelo, filename):
    result = modelo.transcribe(filename, language="es")
    texto = result["text"].strip()
    print(f"Texto detectado: {texto}\n")
    return texto

# 3. Detectar emocion
def detectar_emocion(texto, clasificador):
    resultado = clasificador(texto)
    print("DEBUG resultado:", resultado)
    
    # Si resultado es un diccionario
    if isinstance(resultado, dict):
        resultado = [resultado]

    emocion = resultado[0][0]['label']
    score = resultado[0][0]['score']
    print(f"Emoción detectada: {emocion} (confianza: {score:.2f})\n")


# MAIN
if __name__ == "__main__":
    print(" Cargando modelos...\n")
    modelo_whisper = whisper.load_model("base")
    clasificador_emociones = pipeline("text-classification", model=MODEL_NAME, top_k=1)
    print("Modelos listos\n")

    grabar_audio(AUDIO_FILENAME, DURATION)
    texto = transcribir_audio(modelo_whisper, AUDIO_FILENAME)

    if texto:
        detectar_emocion(texto, clasificador_emociones)
    else:
        print("No se detectó texto en el audio.")
